# Recruit Aid - deny direct access to application files.
# Only /public should ever be web-accessible.

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>

<FilesMatch "\.(env|log|sql|md|json|lock|ini|yml|yaml|example|bak|old|swp|phps)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>
