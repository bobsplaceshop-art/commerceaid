# =====================================================================
# PHPStan configuration
# =====================================================================
#
# Static analysis config for the Anaya Global commerce platform.
#
# Level 5 catches:
#   - Type errors (wrong types passed to functions/methods)
#   - Undefined variables and methods
#   - Unknown classes (missing imports, typos)
#   - Wrong number of arguments to a method
#   - Unreachable code
#   - Dead properties
#
# Not yet enabled (higher levels catch more but demand more
# annotations):
#   - Level 6+: mixed types must be explicitly handled
#   - Level 7+: null propagation analysis
#   - Level 8-9: strict generics, full type completeness
#
# When to bump: after the codebase has 50+ unit tests and every
# method has explicit return types. Until then, level 5 is the
# sweet spot between signal and noise.
# =====================================================================

parameters:
    level: 8
    paths:
        - app
        - routes
    # resources/views is intentionally excluded from the default
    # scan. Views are templates, not application code: they are
    # always invoked from exactly one controller, every variable
    # is passed explicitly by that controller, and the default-
    # guard convention (`$x = $x ?? default`) produces dead-code
    # findings on every line because the analyzer traces the one
    # caller and sees the var is never null. Those findings are
    # noise, not signal. Views are covered by `php -l` (syntax)
    # and by the browser test pass (behavior). To analyze a
    # specific view, pass it explicitly on the CLI:
    #   php vendor/bin/phpstan analyse resources/views/... --memory-limit=512M
    tmpDir: storage/cache/phpstan

    # -----------------------------------------------------------------
    # Ignored errors - benign patterns accepted by policy.
    #
    # Every entry has a reason above it. If the reason stops being
    # true, remove the entry and fix the code. If a NEW kind of
    # benign error appears, add a new identifier here with a reason.
    #
    # These are identifier-based (not line-based), so they survive
    # refactoring. A file moving or a line shifting does not break
    # the ignore.
    #
    # Important: PHPStan reports "Ignored error pattern X was not
    # matched in reported errors" as a failure when an ignore does
    # not match anything. So every entry here MUST correspond to at
    # least one real finding. When we fix the last occurrence of a
    # pattern, we remove its entry too.
    # -----------------------------------------------------------------
    ignoreErrors:
        # REMOVED-THEN-RESTORED 2026-09-27 (level 6 pass).
        #
        # The Batch 1 cleanup removed these 5 patterns because the
        # narrow app/Core + app/Helpers scan showed them as unmatched.
        # That scan was too narrow. The full project scan at the end
        # of Batch 2 revealed all 5 patterns still fire on files
        # outside Core/Helpers:
        #
        #   nullCoalesce.expr     SetupGateMiddleware:47,
        #                         StoreResolutionMiddleware:93
        #   return.unusedType     CheckboxType:22, Hasher:16
        #   arrayValues.list      NotificationRuleService:44
        #   identical.alwaysFalse Hasher:27
        #   nullsafe.neverNull    InventoryController:158
        #
        # Lesson: the stale-ignore check requires a FULL project scan.
        # A directory scan only proves a batch is locally clean.
        # Restoration is the correct move; the code sites are
        # candidates for cleanup in the batches that touch them.
        -
            identifier: nullsafe.neverNull
        -
            identifier: nullCoalesce.expr
        -
            identifier: nullCoalesce.offset

        # Properties written but never read in the class body.
        # Stylistic. Reserved-for-future-use dependencies.
        -
            identifier: property.onlyWritten

        # Return types wider than necessary.
        -
            identifier: return.unusedType

        # array_values() called on an already-list value.
        -
            identifier: arrayValues.list

        # Defensive checks against values proven non-null.
        -
            identifier: identical.alwaysFalse

        # REINSTATED ALL 5 2026-09-27. See note above.
