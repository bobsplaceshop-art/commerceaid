    'mail' => [
        // Laragon ships Mailpit on 1025/8025
        'host'       => '127.0.0.1',
        'port'       => 1025,
        'username'   => null,
        'password'   => null,
        'encryption' => null,
        'from_email' => 'no-reply@anayaglobal.test',
