# Anaya Global - public web root

Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Never serve dotfiles
    RewriteRule ^\. - [F,L]

    # Serve existing files and directories as-is
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Everything else goes through the front controller
    RewriteRule ^ index.php [QSA,L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header unset X-Powered-By

    # ============================================================
    # Content Security Policy
    # ============================================================
    # Restricts which resources the page is allowed to load.
    # Defends against XSS, content injection, clickjacking, and
    # form hijacking.
    #
    # Why 'unsafe-inline' for scripts and styles:
    #   Views embed small inline <style> and <script> blocks
    #   (theme switcher, password toggle, login page layout).
    #   Removing these requires moving the code to external files
    #   served with nonces - a Tier 2+ cleanup. Until then,
    #   'unsafe-inline' is required to keep the app working.
    #
    # Directive-by-directive:
    #   default-src 'self'      - anything not listed below comes only from same origin
    #   script-src  'self' 'unsafe-inline' https://cdn.jsdelivr.net
    #                           - scripts: local + inline + Bootstrap JS
    #   style-src   'self' 'unsafe-inline' https://cdn.jsdelivr.net
    #                           - styles: local + inline + Bootstrap CSS
    #   font-src    'self' data:
    #                           - fonts: local + data URIs. All fonts are
    #                             self-hosted (008G.4c). Bootstrap Icons
    #                             and Font Awesome both ship from
    #                             /assets/. No external font origin.
    #   img-src     'self' data: https://picsum.photos https://fastly.picsum.photos
    #                           - images: local + inline data URIs
    #                             + picsum.photos placeholder
    #                             NOTE - picsum.photos is a DEVELOPMENT
    #                             PLACEHOLDER. When real product and
    #                             category media ships from the store's
    #                             own domain, remove both picsum.photos
    #                             and fastly.picsum.photos from img-src.
    #   connect-src 'self' https://cdn.jsdelivr.net
    #                           - fetch/XHR destinations (jsdelivr for source maps)
    #   frame-ancestors 'none'  - block framing (overlaps with X-Frame-Options)
    #   base-uri    'self'      - prevent <base href> hijacking
    #   form-action 'self'      - forms can only submit to same origin
    #   object-src  'none'      - block Flash, Java, and other plugins
    # ============================================================
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; font-src 'self' data:; img-src 'self' data: https://picsum.photos https://fastly.picsum.photos; connect-src 'self' https://cdn.jsdelivr.net; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none';"

    # ----------------------------------------------------------
    # CSP and X-Frame-Options exception for the campaign raw
    # preview endpoint.
    #
    # The admin campaign detail page embeds this endpoint in a
    # same-origin iframe. The default frame-ancestors 'none'
    # and X-Frame-Options: DENY block that iframe from
    # rendering.
    #
    # The condition matches on %{THE_REQUEST}, the raw request
    # line sent by the client. It is never modified by
    # mod_rewrite. %{REQUEST_URI} and %{QUERY_STRING} are both
    # observed to be unreliable for this purpose on this Apache
    # build after the internal rewrite to index.php. Do not
    # substitute them back.
    #
    # The trailing space in the regex separates the URI from
    # the HTTP protocol version in the request line, so
    # ?raw=1something does not accidentally match.
    #
    # Scope: only the raw preview (?raw=1) receives the
    # exemption. The full preview page keeps the default
    # frame-ancestors 'none' and X-Frame-Options: DENY.
    #
    # The raw preview is admin-only (behind the store, auth,
    # and permission middleware). It renders the merchant's
    # own campaign HTML inside a sandboxed iframe with no
    # same-origin access to the admin page.
    # ----------------------------------------------------------
    <If "%{THE_REQUEST} =~ m#^GET /commerce/ca-admin/campaigns/[0-9]+/preview\?raw=1 #">
        Header always unset X-Frame-Options
        Header always set X-Frame-Options "SAMEORIGIN"
        Header always unset Content-Security-Policy
        Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none';"
    </If>
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css                "access plus 30 days"
    ExpiresByType application/javascript  "access plus 30 days"
    ExpiresByType image/svg+xml           "access plus 30 days"
    ExpiresByType image/png               "access plus 30 days"
    ExpiresByType image/jpeg              "access plus 30 days"
</IfModule>
