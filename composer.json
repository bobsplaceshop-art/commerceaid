{
    "name": "corporateaid/commerce-platform",
    "description": "White-labelled multi-tenant commerce platform — Anaya Global deployment",
    "type": "project",
    "license": "proprietary",
    "version": "0.1.0-alpha",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-fileinfo": "*",
        "ext-json": "*",
        "ext-ctype": "*",
        "ext-tokenizer": "*",
        "ext-dom": "*",
        "ext-gd": "*",
        "phpmailer/phpmailer": "^6.9",
        "dompdf/dompdf": "^3.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "CorporateAid\\Core\\": "app/Core/",
            "CorporateAid\\Platform\\": "app/Platform/",
            "CorporateAid\\Commerce\\": "app/Commerce/",
            "CorporateAid\\Helpers\\": "app/Helpers/"
        },
        "files": [
            "app/Helpers/functions.php"
        ]
    },
    "scripts": {
        "lint": "php bin/lint.php",
        "analyse": "phpstan analyse --memory-limit=512M",
        "check": [
            "@lint",
            "@analyse",
            "@prevenger"
        ],
        "hook:install": "php bin/install-hooks.php",
        "hook:uninstall": [
            "git config --unset core.hooksPath || true"
        ],
        "prevenger": "php bin/check.php",
        "smoke": "php bin/smoke.php"
    },
    "config": {
        "optimize-autoloader": true,
        "classmap-authoritative": false,
        "sort-packages": true,
        "platform": {
            "php": "8.2.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
